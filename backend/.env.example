# ──────────────────────────────────────────────
# BACKEND - Variables PRIVADAS (solo en Vercel)
# ──────────────────────────────────────────────
# Estas variables se configuran en Vercel Dashboard → Settings → Environment Variables
# NUNCA deben estar en un archivo .env subido al frontend o al repositorio.

# ── Base de datos (MariaDB en el VPS) ──
# El VPS debe tener MariaDB escuchando en 0.0.0.0 (no solo 127.0.0.1)
# y el firewall debe permitir conexiones desde las IPs de Vercel.
MARIADB_HOST=IP_PUBLICA_DEL_VPS
MARIADB_PORT=3306
MARIADB_DATABASE=ruleta
MARIADB_USER=ruleta_app
MARIADB_PASSWORD=tu_password_seguro

# ── Auth ──
OPERATOR_PASSWORD=cambia_esto_por_una_contraseña_segura
SESSION_SECRET=genera_con_node_e_crypto_randomBytes_32_hex
TICKET_ENCRYPTION_KEY=genera_con_node_e_crypto_randomBytes_32_base64

# ── CORS ──
# Dominio exacto del frontend (el del VPS/dominio real)
FRONTEND_ORIGIN=https://ruleta.tudominio.com

# ── General ──
NODE_ENV=production
PORT=3001

# URL pública para generar QR (debe ser HTTPS)
PUBLIC_APP_URL=https://ruleta.tudominio.com